# Installed as /etc/bt-gateway/gateway.env; existing file is never overwritten.
# Supported Bluetooth controller: hci0. Supported network backend: existing Netplan.
BTG_WLAN=wlan0
BTG_NETPLAN_WIFI=/etc/netplan/30-wifis-dhcp.yaml
BTG_DEV_NAME="Orange Pi Bluetooth Gateway"

# Optional mihomo external-controller integration. Keep the controller on loopback.
# BTG_MIHOMO_API=http://127.0.0.1:9090
# BTG_MIHOMO_SECRET_FILE=/etc/mihomo/secret
# BTG_MIHOMO_GROUP=PROXY
# BTG_MIHOMO_TEST_URL=https://www.gstatic.com/generate_204
